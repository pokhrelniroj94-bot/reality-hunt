# ==============================================================================
# REALITY HUNT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Supabase Backend Configuration (Optional for Cloud Sync; Local Storage used by default)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-do-not-expose

# AI Dialogue Service (Optional; Local Scripted Fallback runs seamlessly if omitted)
# In production, set GEMINI_API_KEY to enable live generative AI responses via server/api/aiDialogue.ts
GEMINI_API_KEY=your_gemini_api_key_here

# Telemetry & Safety
VITE_ENFORCE_SAFETY_GUARDRAILS=true
VITE_DEFAULT_INTENSITY=STANDARD
